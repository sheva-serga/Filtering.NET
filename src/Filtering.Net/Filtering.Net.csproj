<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Filtering.Net</PackageId>
    <Title>Filtering.Net — Source-Generated IQueryable Filtering</Title>
    <Description>Type-safe filter, sort, and pagination for IQueryable and EF Core. Source-generated at compile time, with no reflection at request time.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- 8.0.5 patches GHSA-8g4q-xg66-9fp4 and GHSA-hh2w-p6rv-4g7w (plan specified 8.0.0; bumped to remove vulnerability under TreatWarningsAsErrors). -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
