<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>Serhii Shevchenko</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) Serhii Shevchenko</Copyright>

    <!-- Shared NuGet metadata. Per-package overrides go in each csproj. -->
    <Version>0.0.0</Version>
    <PackageProjectUrl>https://github.com/sheva-serga/Filtering.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sheva-serga/Filtering.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>filter;sort;page;source-generator;efcore;linq;iqueryable;roslyn</PackageTags>
    <PackageReleaseNotes>https://github.com/sheva-serga/Filtering.Net/blob/v$(Version)/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
