<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>Serhii Shevchenko</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) Serhii Shevchenko</Copyright>

    <!-- Shared NuGet metadata. Per-package overrides go in each csproj. -->
    <Version>0.0.0</Version>
    <PackageProjectUrl>https://github.com/sheva-serga/Filtering.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sheva-serga/Filtering.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>filter;sort;page;source-generator;efcore;linq;iqueryable;roslyn</PackageTags>
  </PropertyGroup>
</Project>
